# Public Chatbase website widget ID. This is safe to expose in the client bundle.
# Leave unset to use the default widget configured in the app.
VITE_CHATBASE_CHATBOT_ID=your_chatbase_widget_id_here

# Dominio público del sitio (solo se usa al compilar). Sirve para que los links de cada
# mockup tengan og:url y para convertir imágenes locales (/brand/...) en URLs absolutas.
# Ejemplo: https://previews.kafkastudio.pe
SITE_URL=

# Variables públicas de Supabase usadas por Kafka Commerce.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Si tu proyecto usa la nomenclatura nueva de Supabase, también se acepta esta variable:
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STORE_ID=
VITE_STORE_NAME=Kafka Commerce Demo
VITE_WHATSAPP_PHONE=51999999999
